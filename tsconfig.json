{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["DOM", "ES2020"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
